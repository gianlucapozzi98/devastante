---
import Base from '../layouts/Base.astro';
import TestaPagina from '../components/ui/TestaPagina.astro';
import DaConfermare from '../components/ui/DaConfermare.astro';
import AvvisiForm from '../components/ui/AvvisiForm.astro';
import { getCollection } from 'astro:content';
import { impostazioni, orari, indirizzoCompleto, prestoInApertura, dataAperturaLeggibile, ordinaHref } from '../lib/site';

const indirizzo = indirizzoCompleto();
const data = dataAperturaLeggibile();
const faqCollezione = (await getCollection('faq')).map((f) => f.data).sort((a, b) => a.ordine - b.ordine);
const faqApertura = {
  domanda: 'Il locale è già aperto?',
  risposta: prestoInApertura
    ? `Non ancora: stiamo preparando l'apertura.${data ? ` Apriamo il ${data}.` : ' La data sarà pubblicata qui appena confermata.'} Puoi iscriverti agli avvisi di apertura in questa pagina.`
    : 'Sì. Trovi indirizzo e orari in questa pagina.',
  confermata: true,
  ordine: 0,
};
const faq = [faqApertura, ...faqCollezione];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.filter((f) => f.confermata).map((f) => ({ '@type': 'Question', name: f.domanda, acceptedAnswer: { '@type': 'Answer', text: f.risposta } })),
};
const passi = [
  { t: 'Scegli', d: 'Guarda il menu: tranci, smash e bevande, con allergeni.', link: '/menu', l: 'Apri il menu' },
  { t: 'Ordina', d: impostazioni.telefono ? `Chiama il ${impostazioni.telefono}.` : null },
  { t: 'Ritira o ricevi', d: impostazioni.asporto === 'si' ? 'Passa a ritirare al banco.' : null },
];
---
<Base titolo="Dove siamo e come ordinare | DEVASTANTE Cesano Boscone" descrizione="DEVASTANTE a Cesano Boscone: indirizzo, orari, come ordinare pizza in teglia e smash burger. Presto in apertura: iscriviti agli avvisi." jsonLd={faqLd.mainEntity.length ? [faqLd] : []}>
  <TestaPagina occhiello="Dove siamo · Ordina" titolo="Vieni a casa">
    {prestoInApertura && <p><strong>Presto in apertura.</strong> {data ? `Apriamo il ${data}.` : 'La data di apertura sarà pubblicata appena confermata.'}</p>}
  </TestaPagina>

  <section class="contenitore info" data-anim="rivela">
    <article class="info__scheda" data-rivela>
      <h2 class="display">Indirizzo</h2>
      <p>{indirizzo ?? <><DaConfermare>via e numero civico</DaConfermare><br />{impostazioni.citta}</>}</p>
      {impostazioni.mappaUrl ? <a class="btn btn--piccolo btn--linea" href={impostazioni.mappaUrl} target="_blank" rel="noopener">Apri nelle mappe<span class="sr-only"> (si apre in una nuova finestra)</span></a> : <p><DaConfermare>link alla mappa</DaConfermare></p>}
    </article>
    <article class="info__scheda" id="orari" data-rivela>
      <h2 class="display">Orari</h2>
      <table class="orari">
        <caption class="sr-only">Orari di apertura</caption>
        <tbody>
          {orari.giorni.map((g) => (
            <tr><th scope="row">{g.giorno}</th><td>{g.stato === 'aperto' ? g.fasce || <DaConfermare>fasce orarie</DaConfermare> : g.stato === 'chiuso' ? 'Chiuso' : <DaConfermare>orario</DaConfermare>}</td></tr>
          ))}
        </tbody>
      </table>
      {orari.nota && <p>{orari.nota}</p>}
    </article>
    <article class="info__scheda" data-rivela>
      <h2 class="display">Contatti</h2>
      <p>Telefono: {impostazioni.telefono ? <a href={`tel:${impostazioni.telefono.replace(/\s+/g, '')}`}>{impostazioni.telefono}</a> : <DaConfermare>telefono</DaConfermare>}</p>
      <p>WhatsApp: {impostazioni.whatsapp ? <a href={`https://wa.me/${impostazioni.whatsapp.replace(/\D/g, '')}`} target="_blank" rel="noopener">{impostazioni.whatsapp}</a> : <DaConfermare>WhatsApp, se c'è</DaConfermare>}</p>
      <p>Email: {impostazioni.email ? <a href={`mailto:${impostazioni.email}`}>{impostazioni.email}</a> : <DaConfermare>email</DaConfermare>}</p>
      <p>Pagamenti: {impostazioni.pagamenti || <DaConfermare>metodi di pagamento</DaConfermare>}</p>
    </article>
  </section>

  <section class="contenitore mappa" aria-labelledby="mappa-t" data-anim="mappa">
    <h2 id="mappa-t" class="sr-only">Mappa</h2>
    <div class="mappa__box" data-mappa-box data-embed={impostazioni.mappaEmbed ?? ''}>
      <div class="mappa__vuota">
        {impostazioni.mappaEmbed ? (
          <>
            <p>La mappa interattiva è di un fornitore esterno e si carica solo con il tuo consenso.</p>
            <button type="button" class="btn btn--piccolo" data-mappa-consenso>Mostra la mappa</button>
          </>
        ) : (
          <p>Mappa in arrivo: serve l'indirizzo definitivo. <DaConfermare>indirizzo e mappa</DaConfermare></p>
        )}
      </div>
    </div>
  </section>

  <section class="contenitore ordina" id="ordina" aria-labelledby="ordina-t" data-anim="rivela">
    <h2 id="ordina-t" class="display ordina__titolo" data-rivela>Come ordinare, in 3 passi</h2>
    <ol class="passi">
      {passi.map((p, i) => (
        <li class="passo" data-rivela>
          <span class="passo__n display">{i + 1}</span>
          <h3 class="display">{p.t}</h3>
          <p>{p.d ?? <DaConfermare>modalità</DaConfermare>}</p>
          {p.link && <a href={p.link}>{p.l}</a>}
        </li>
      ))}
    </ol>
    <div class="ordina__canali" data-rivela>
      <p><strong>Asporto:</strong> {impostazioni.asporto === 'si' ? 'sì' : impostazioni.asporto === 'no' ? 'no' : <DaConfermare>asporto</DaConfermare>} · <strong>Consegna:</strong> {impostazioni.consegna === 'app' ? 'con app di consegna' : impostazioni.consegna === 'diretta' ? 'sì' : impostazioni.consegna === 'no' ? 'no' : <DaConfermare>consegna</DaConfermare>}</p>
      {impostazioni.app.length > 0 && <ul>{impostazioni.app.map((a) => <li><a href={a.url ?? '#'} target="_blank" rel="noopener">{a.nome}</a></li>)}</ul>}
      <a class="btn" href={ordinaHref()}>Ordina</a>
    </div>
  </section>

  <section class="contenitore faq" aria-labelledby="faq-t" data-anim="rivela">
    <h2 id="faq-t" class="display faq__titolo" data-rivela>Domande frequenti</h2>
    <div class="faq__lista">
      {faq.map((f) => (
        <details class="faq__voce" data-rivela>
          <summary>{f.domanda}</summary>
          <p>{f.risposta.includes('[') ? <span class="da-confermare">{f.risposta}</span> : f.risposta}</p>
        </details>
      ))}
    </div>
  </section>

  {prestoInApertura && (
    <section class="contenitore avvisi" id="avvisi" aria-label="Avvisi di apertura">
      <AvvisiForm id="avvisi-dove" />
    </section>
  )}
</Base>

<style>
  .info { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(12px, 2vw, 24px); padding-bottom: clamp(40px, 6vw, 70px); }
  .info__scheda { background: var(--bianco); border-radius: var(--r-trancio); padding: 24px; box-shadow: 0 0 0 2px var(--nero); display: grid; gap: 10px; align-content: start; scroll-margin-top: calc(var(--nav-h) + 20px); }
  .info__scheda h2 { font-size: 1.8rem; }
  .info__scheda p { margin: 0; }
  .info__scheda .btn { justify-self: start; }
  .orari { border-collapse: collapse; width: 100%; font-size: var(--fs-s); }
  .orari th { text-align: left; font-weight: 700; padding: 6px 12px 6px 0; }
  .orari td { padding: 6px 0; }
  .orari tr + tr { border-top: 1px solid var(--carta-2); }
  .mappa { padding-bottom: clamp(40px, 6vw, 70px); }
  .mappa__box { position: relative; aspect-ratio: 21 / 9; border-radius: 22px; overflow: hidden; background: radial-gradient(circle at 1px 1px, rgb(0 0 0 / 0.16) 1px, transparent 1.4px) 0 0 / 12px 12px, var(--carta-2); box-shadow: 0 0 0 2px var(--nero); }
  .mappa__box :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .mappa__vuota { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 12px; text-align: center; padding: 20px; }
  .mappa__vuota p { margin: 0; max-width: 46ch; font-weight: 600; }
  .ordina { padding-bottom: clamp(50px, 7vw, 90px); scroll-margin-top: calc(var(--nav-h) + 20px); }
  .ordina__titolo, .faq__titolo { font-size: var(--fs-xl); margin-bottom: 24px; }
  .passi { list-style: none; margin: 0 0 24px; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(12px, 2vw, 24px); }
  .passo { position: relative; background: var(--carta-2); border-radius: var(--r-trancio); padding: 26px 24px 24px; display: grid; gap: 8px; align-content: start; }
  .passo__n { font-size: 3.6rem; line-height: 0.8; color: var(--rosso); }
  .passo h3 { font-size: 1.6rem; }
  .passo p { margin: 0; }
  .passo a { font-weight: 800; color: var(--nero); text-decoration-color: var(--rosso); text-decoration-thickness: 3px; }
  .ordina__canali { display: grid; gap: 12px; justify-items: start; }
  .ordina__canali p { margin: 0; }
  .faq { padding-bottom: clamp(50px, 7vw, 90px); }
  .faq__lista { display: grid; gap: 10px; max-width: 820px; }
  .faq__voce { background: var(--bianco); border-radius: 14px; box-shadow: 0 0 0 2px var(--nero); }
  .faq__voce summary { cursor: pointer; padding: 18px 20px; font-weight: 800; font-size: var(--fs-l); list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  .faq__voce summary::-webkit-details-marker { display: none; }
  .faq__voce summary::after { content: '+'; color: var(--rosso); font-size: 1.6rem; line-height: 1; transition: transform var(--t-ui) var(--ease-out); }
  .faq__voce[open] summary::after { transform: rotate(45deg); }
  .faq__voce p { margin: 0; padding: 0 20px 20px; }
  .avvisi { padding-bottom: clamp(70px, 9vw, 120px); scroll-margin-top: calc(var(--nav-h) + 20px); }
  @media (max-width: 899px) {
    .info, .passi { grid-template-columns: 1fr; }
    .mappa__box { aspect-ratio: 4 / 3; }
  }
</style>
