---
import Base from '../layouts/Base.astro';
---
<Base titolo="Manca un trancio | DEVASTANTE" descrizione="Pagina non trovata." noindex>
  <section class="contenitore nf" data-anim="rivela">
    <div class="nf__teglia" aria-hidden="true" data-rivela>
      <span></span><span></span><span></span><span class="nf__vuoto"></span><span></span><span></span>
      <svg class="nf__linea" viewBox="0 0 600 40" preserveAspectRatio="none"><path d="M0 20 C 60 10, 120 30, 200 20 S 300 12, 330 20" /><path d="M400 22 C 440 30, 520 10, 600 20" /></svg>
    </div>
    <p class="occhiello" data-rivela>Errore 404</p>
    <h1 class="display nf__titolo" data-rivela data-split>Qui manca un trancio.</h1>
    <p class="lead" data-rivela>La pagina che cerchi non c'è (o qualcuno l'ha già mangiata). Ripartiamo dalla teglia.</p>
    <div class="nf__azioni" data-rivela>
      <a class="btn" href="/">Torna alla home</a>
      <a class="btn btn--linea" href="/menu">Guarda il menu</a>
    </div>
  </section>
</Base>
<style>
  .nf { min-height: 100svh; display: grid; align-content: center; justify-items: start; gap: 16px; padding-block: calc(var(--nav-h) + 40px) 80px; }
  .nf__teglia { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; width: min(420px, 90vw); padding: 12px; border-radius: 20px; background: var(--teglia); margin-bottom: 20px; }
  .nf__teglia span { aspect-ratio: 1; border-radius: 8px; background: var(--rosso); }
  .nf__teglia span:nth-child(2n) { background: var(--nero); }
  .nf__teglia .nf__vuoto { background: transparent; box-shadow: inset 0 0 0 3px var(--carta); border-radius: 8px; background-image: repeating-linear-gradient(-45deg, transparent 0 8px, rgb(255 255 255 / 0.3) 8px 10px); }
  .nf__linea { position: absolute; left: -20px; right: -20px; bottom: -28px; width: calc(100% + 40px); height: 30px; overflow: visible; }
  .nf__linea path { fill: none; stroke: var(--rosso); stroke-width: 6; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .nf__titolo { font-size: var(--fs-xxl); }
  .nf__azioni { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
