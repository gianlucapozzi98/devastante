---
import Base from '../layouts/Base.astro';
import TestaPagina from '../components/ui/TestaPagina.astro';
import Foto from '../components/ui/Foto.astro';
import DaConfermare from '../components/ui/DaConfermare.astro';
import { getCollection } from 'astro:content';
import { ordinaHref, impostazioni } from '../lib/site';

const voci = (await getCollection('menu')).map((v) => ({ id: v.id, ...v.data })).sort((a, b) => a.categoria.localeCompare(b.categoria) || a.ordine - b.ordine);
const ordine = ['pizze', 'smash', 'bevande'] as const;
voci.sort((a, b) => ordine.indexOf(a.categoria) - ordine.indexOf(b.categoria) || a.ordine - b.ordine);
const offerte = (await getCollection('offerte')).filter((o) => o.data.attiva);
const filtri = [
  { id: 'tutto', label: 'Tutto' },
  { id: 'pizze', label: 'Pizze in teglia' },
  { id: 'smash', label: 'Smash' },
  { id: 'bevande', label: 'Bevande' },
];
const nomeCat = { pizze: 'Pizza in teglia', smash: 'Smash', bevande: 'Bevanda' } as const;
const unita = { 'da-confermare': null, trancio: 'al trancio', kg: 'al kg', pezzo: 'al pezzo' } as const;
const allergeniNomi: Record<string, string> = { glutine: 'Glutine', crostacei: 'Crostacei', uova: 'Uova', pesce: 'Pesce', arachidi: 'Arachidi', soia: 'Soia', latte: 'Latte', 'frutta-a-guscio': 'Frutta a guscio', sedano: 'Sedano', senape: 'Senape', sesamo: 'Sesamo', solfiti: 'Anidride solforosa e solfiti', lupini: 'Lupini', molluschi: 'Molluschi' };
const ordineOnline = impostazioni.app.length > 0;
const forme = ['14px 22px 12px 26px', '24px 12px 20px 14px', '12px 18px 26px 16px', '20px 26px 14px 12px'];
---
<Base titolo="Menu | DEVASTANTE · Pizza in teglia e smash burger" descrizione="Il menu di DEVASTANTE a Cesano Boscone: pizza in teglia al trancio, smash burger e bevande. Ingredienti e allergeni per ogni prodotto.">
  <TestaPagina occhiello="Menu" titolo="La teglia, trancio per trancio">
    <p>Il menu è <strong>in preparazione</strong>: gusti, ingredienti e prezzi arrivano appena il titolare li conferma. Per gli allergeni c'è la <a href="/allergeni">pagina dedicata</a>.</p>
  </TestaPagina>

  <section class="contenitore menu" data-anim="menu" aria-label="Prodotti">
    <div class="filtri" role="group" aria-label="Filtra il menu">
      {filtri.map((f, i) => <button type="button" class="filtro" data-filtro={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>)}
    </div>
    <p class="menu__conta" aria-live="polite" data-conta>{voci.length} prodotti</p>

    {offerte.length > 0 && (
      <ul class="offerte">{offerte.map((o) => <li><strong>{o.data.titolo}</strong> — {o.data.testo}</li>)}</ul>
    )}

    <div class="teglia-menu">
      <ul class="griglia-tranci">
        {voci.map((v, i) => (
          <li class="trancio-menu" data-cat={v.categoria} style={`--forma:${forme[i % forme.length]}`}>
            <button type="button" class="trancio-menu__btn" aria-haspopup="dialog" aria-controls={`scheda-${v.id}`} data-apri={`scheda-${v.id}`}>
              <Foto class="trancio-menu__foto" slot={`menu-${v.id}`} src={v.foto} alt={v.nome} nota={v.categoria === 'smash' ? 'foto dello smash, macro' : v.categoria === 'pizze' ? 'foto del trancio, dall\'alto' : 'foto della bevanda'} sizes="(min-width: 900px) 25vw, 50vw" />
              <span class="trancio-menu__cat">{nomeCat[v.categoria]}</span>
              <span class="trancio-menu__nome display">{v.nome}</span>
              <span class="trancio-menu__prezzo">{v.confermato && v.prezzo ? `€ ${v.prezzo}${unita[v.unita] ? ' ' + unita[v.unita] : ''}` : <DaConfermare>prezzo</DaConfermare>}</span>
              <span class="trancio-menu__apri" aria-hidden="true">+</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
    <p class="menu__note">Prezzi IVA inclusa (quando confermati). {voci.some((v) => v.unita === 'kg') && 'Per i prodotti al peso è indicato il prezzo al kg.'} Chiedi sempre al personale per allergie e intolleranze.</p>
    <a class="btn" href={ordinaHref()}>Ordina</a>
  </section>

  {voci.map((v) => (
    <dialog class="scheda-prodotto" id={`scheda-${v.id}`} aria-labelledby={`scheda-${v.id}-t`}>
      <div class="scheda-prodotto__in">
        <button type="button" class="scheda-prodotto__chiudi" data-chiudi aria-label="Chiudi la scheda">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
        </button>
        <Foto class="scheda-prodotto__foto" slot={`menu-${v.id}`} src={v.foto} alt={v.nome} nota="foto vera del prodotto" sizes="(min-width: 900px) 40vw, 100vw" />
        <p class="occhiello">{nomeCat[v.categoria]}</p>
        <h2 id={`scheda-${v.id}-t`} class="display scheda-prodotto__nome">{v.nome}</h2>
        <p>{v.descrizione}</p>
        <h3>Ingredienti</h3>
        {v.ingredienti.length ? <ul>{v.ingredienti.map((x) => <li>{x}</li>)}</ul> : <p><DaConfermare>ingredienti</DaConfermare></p>}
        <h3>Allergeni</h3>
        {v.confermato ? (v.allergeni.length ? <ul class="scheda-prodotto__allergeni">{v.allergeni.map((a) => <li>{allergeniNomi[a] ?? a}</li>)}</ul> : <p>Nessuno dei 14 allergeni del Reg. UE 1169/2011 dichiarato.</p>) : <p><DaConfermare>allergeni</DaConfermare></p>}
        <h3>Prezzo</h3>
        <p>{v.confermato && v.prezzo ? `€ ${v.prezzo} IVA inclusa${unita[v.unita] ? ' · ' + unita[v.unita] : ''}` : <DaConfermare>prezzo IVA inclusa</DaConfermare>}</p>
        {ordineOnline ? <a class="btn" href={impostazioni.app[0]?.url ?? '/dove-siamo#ordina'} rel="noopener">Ordina online</a> : <a class="btn btn--linea" href="/dove-siamo#ordina">Come ordinare</a>}
      </div>
    </dialog>
  ))}
</Base>

<style>
  .menu { padding-bottom: clamp(80px, 10vw, 140px); display: grid; gap: 22px; }
  .filtri { display: flex; flex-wrap: wrap; gap: 10px; }
  .filtro { min-height: 46px; padding: 0 1.2em; border-radius: 999px; border: 2.5px solid var(--nero); background: transparent; font-weight: 800; transition: background var(--t-micro), color var(--t-micro), transform var(--t-micro) var(--ease-out); }
  .filtro:hover { transform: translateY(-2px); }
  .filtro[aria-pressed='true'] { background: var(--nero); color: var(--carta); }
  .menu__conta { margin: 0; font-weight: 700; color: var(--cenere); }
  .offerte { list-style: none; margin: 0; padding: 16px 20px; border-radius: 14px; background: var(--formaggio); }
  .teglia-menu { padding: clamp(10px, 1.4vw, 18px); border-radius: 26px; background: linear-gradient(160deg, #b7b5b1 0%, #9c9a96 35%, #8a8884 70%, #a9a7a3 100%); box-shadow: inset 0 0 0 2px rgb(255 255 255 / 0.35), 0 30px 60px -24px rgb(0 0 0 / 0.35); }
  .griglia-tranci { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
  .trancio-menu { border-radius: var(--forma); overflow: hidden; }
  .trancio-menu[hidden] { display: none; }
  .trancio-menu__btn { position: relative; width: 100%; height: 100%; display: grid; grid-template-rows: auto auto 1fr auto; gap: 6px; text-align: left; border: 0; padding: 0 0 16px; background: var(--carta); transition: transform var(--t-ui) var(--ease-out), box-shadow var(--t-ui) var(--ease-out); }
  .trancio-menu__btn:hover { transform: translateY(-6px) rotate(-1deg); box-shadow: 0 18px 30px -12px rgb(0 0 0 / 0.4); }
  .trancio-menu__btn :global(.trancio-menu__foto) { aspect-ratio: 1; border-radius: 0; }
  .trancio-menu__cat { padding: 0 16px; margin-top: 8px; font-size: var(--fs-xs); font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--cenere); }
  .trancio-menu__nome { padding: 0 16px; font-size: clamp(1.3rem, 1rem + 1vw, 1.9rem); line-height: 1; }
  .trancio-menu__prezzo { padding: 0 16px; font-weight: 800; }
  .trancio-menu__apri { position: absolute; top: 12px; right: 12px; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--rosso); color: var(--bianco); font-size: 1.6rem; font-weight: 700; transition: transform var(--t-ui) var(--ease-out); }
  .trancio-menu__btn:hover .trancio-menu__apri { transform: rotate(90deg) scale(1.1); }
  .menu__note { margin: 0; font-size: var(--fs-s); color: var(--cenere); }
  .menu .btn { justify-self: start; }
  .scheda-prodotto { margin: 0 0 0 auto; height: 100dvh; max-height: 100dvh; width: min(560px, 100vw); border: 0; padding: 0; background: var(--carta); color: var(--nero); overflow: auto; }
  .scheda-prodotto::backdrop { background: rgb(0 0 0 / 0.55); }
  .scheda-prodotto__in { padding: 24px clamp(20px, 3vw, 36px) 40px; display: grid; gap: 10px; }
  .scheda-prodotto__in h3 { font-family: var(--f-body); font-weight: 800; font-size: var(--fs-xs); letter-spacing: 0.14em; text-transform: uppercase; margin-top: 12px; }
  .scheda-prodotto__in p, .scheda-prodotto__in ul { margin: 0; }
  .scheda-prodotto__in :global(.scheda-prodotto__foto) { aspect-ratio: 4 / 3; margin-bottom: 10px; }
  .scheda-prodotto__nome { font-size: var(--fs-xl); }
  .scheda-prodotto__chiudi { position: sticky; top: 0; justify-self: end; z-index: 2; width: 48px; height: 48px; border-radius: 50%; border: 0; background: var(--nero); color: var(--carta); display: grid; place-items: center; }
  .scheda-prodotto__chiudi svg { width: 22px; height: 22px; }
  .scheda-prodotto .btn { justify-self: start; margin-top: 14px; }
  @media (max-width: 899px) { .griglia-tranci { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 420px) { .trancio-menu__nome { font-size: 1.15rem; } }
</style>
