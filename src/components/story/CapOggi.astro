---
import type { CollectionEntry } from 'astro:content';
import Foto from '../ui/Foto.astro';
import { prestoInApertura, dataAperturaLeggibile } from '../../lib/site';
interface Props { cap: CollectionEntry<'capitoli'>['data'] }
const { cap } = Astro.props;
const data = dataAperturaLeggibile();
const vetrine = [
  { scritta: 'La teglia', nota: 'la vetrina con le teglie, da fuori', alt: 'La vetrina della teglia del nuovo locale' },
  { scritta: 'Lo smash', nota: 'la piastra dello smash, da fuori', alt: 'La vetrina dello smash del nuovo locale' },
];
---
<section id={cap.ancora} class="cap cap-oggi" data-anim="cap-oggi" data-capitolo={cap.etichetta} data-presto={prestoInApertura ? '1' : '0'} aria-labelledby={`${cap.ancora}-t`}>
  <div class="cap-oggi__pin contenitore">
    <div class="negozio" aria-hidden="true">
      <div class="negozio__insegna"><img src="/brand/devastante-logo.svg" alt="" width="2130" height="675" loading="lazy" /></div>
      <div class="negozio__vetrine">
        {vetrine.map((v) => (
          <div class="vetrina">
            <div class="vetrina__dentro">
              <Foto class="vetrina__foto" alt={v.alt} nota={v.nota} sfondo="#211f1c" inchiostro="#f6f1e7" sizes="(min-width: 900px) 25vw, 45vw" />
              <span class="vetrina__scritta display">{v.scritta}</span>
            </div>
            <div class="saracinesca" data-saracinesca><span class="saracinesca__maniglia"></span></div>
          </div>
        ))}
      </div>
      <div class="negozio__soglia"></div>
      {prestoInApertura && (
        <div class="cartello" data-cartello>
          <span class="cartello__filo"></span>
          <span class="cartello__testo">{data ? <>Apre il<br />{data}</> : <>Presto in<br />apertura</>}</span>
        </div>
      )}
    </div>
    <div class="cap__testo cap-oggi__testo">
      <p class="occhiello">{cap.occhiello}</p>
      <h2 id={`${cap.ancora}-t`} class="cap__titolo">{cap.titolo}</h2>
      <p class="lead">{cap.testo}</p>
      {prestoInApertura && <p class="cap-oggi__nota">Il locale non è ancora aperto. <a href="#avvisi">Avvisami quando apre</a></p>}
    </div>
  </div>
</section>

<style>
  .cap-oggi { padding-block: clamp(60px, 8vw, 120px); }
  .cap-oggi__pin { min-height: 100svh; display: grid; grid-template-columns: 1.2fr 0.8fr; align-items: center; gap: clamp(28px, 5vw, 80px); }
  .negozio { position: relative; padding: clamp(14px, 1.6vw, 22px); background: var(--nero); border-radius: 18px 18px 6px 6px; box-shadow: 0 30px 60px -24px rgb(0 0 0 / 0.5); }
  .negozio__insegna { background: var(--bianco); border-radius: 10px; padding: clamp(10px, 1.6vw, 22px) clamp(18px, 3vw, 44px); display: grid; place-items: center; margin-bottom: clamp(12px, 1.5vw, 20px); }
  .negozio__insegna img { width: min(72%, 420px); height: auto; }
  .negozio__vetrine { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(12px, 1.5vw, 20px); }
  .vetrina { position: relative; aspect-ratio: 3 / 4; border-radius: 6px; overflow: hidden; background: #211f1c; box-shadow: inset 0 0 0 4px #3a3836; }
  .vetrina__dentro { position: absolute; inset: 0; display: grid; }
  .vetrina__dentro :global(.vetrina__foto) { position: absolute; inset: 0; border-radius: 0; }
  .vetrina__dentro::after { content: ''; position: absolute; inset: 0; background: linear-gradient(115deg, rgb(255 255 255 / 0.14) 0 18%, transparent 18% 30%, rgb(255 255 255 / 0.06) 30% 34%, transparent 34%); pointer-events: none; }
  .vetrina__scritta { position: absolute; left: 0; right: 0; top: 52%; text-align: center; font-size: clamp(1.6rem, 3.4vw, 3.4rem); color: var(--bianco); text-shadow: 3px 3px 0 var(--rosso); z-index: 1; }
  .saracinesca {
    position: absolute; inset: 0; z-index: 2;
    background: repeating-linear-gradient(180deg, #a9a7a3 0 10px, #8d8b87 10px 13px, #b8b6b2 13px 22px, #7d7b77 22px 24px);
    box-shadow: inset 0 -6px 0 #5c5a56; border-bottom: 6px solid #3a3836;
  }
  .saracinesca__maniglia { position: absolute; bottom: 14px; left: 50%; width: 22%; height: 8px; transform: translateX(-50%); border-radius: 6px; background: #3a3836; }
  .negozio__soglia { height: 14px; margin: 12px -10px -8px; border-radius: 4px; background: var(--teglia); }
  .cartello { position: absolute; left: 50%; top: 38%; transform-origin: 50% 0; translate: -50% 0; z-index: 4; display: grid; justify-items: center; }
  .cartello__filo { width: 70px; height: 34px; border: 2px solid var(--carta); border-bottom: 0; border-radius: 40px 40px 0 0; }
  .cartello__testo { background: var(--bianco); color: var(--nero); border: 3px solid var(--nero); border-radius: 10px; padding: 0.5em 0.9em; font-family: var(--f-display); font-size: clamp(1rem, 1.6vw, 1.5rem); line-height: 1; text-align: center; box-shadow: 4px 4px 0 var(--rosso); }
  .cap-oggi__nota { font-weight: 700; margin-top: 18px; }
  .cap-oggi__nota a { color: var(--nero); text-decoration-color: var(--rosso); text-decoration-thickness: 3px; }
  @media (prefers-reduced-motion: reduce) {
    .cap-oggi[data-presto='1'] .saracinesca { transform: translateY(-55%); }
    .cap-oggi[data-presto='0'] .saracinesca { transform: translateY(-100%); }
  }
  @media (max-width: 899px) {
    .cap-oggi__pin { grid-template-columns: 1fr; min-height: auto; }
  }
  @media (max-width: 600px) {
    .vetrina__dentro :global(.foto__nota) { display: none; }
    .vetrina__scritta { top: 60%; }
  }
</style>
