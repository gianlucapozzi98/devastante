---
import Base from './Base.astro';
import TestaPagina from '../components/ui/TestaPagina.astro';
interface Props { titolo: string; descrizione: string; occhiello?: string; bozza?: boolean; aggiornamento?: string }
const { titolo, descrizione, occhiello = 'Informazioni legali', bozza = true, aggiornamento = '23 novembre 2026' } = Astro.props;
---
<Base titolo={`${titolo} | DEVASTANTE`} descrizione={descrizione}>
  <TestaPagina occhiello={occhiello} titolo={titolo}>
    {bozza && <p class="bozza"><strong>BOZZA da far validare</strong> a un consulente legale prima della pubblicazione. I campi evidenziati vanno completati con i dati reali.</p>}
  </TestaPagina>
  <article class="contenitore legale">
    <slot />
    <p class="legale__agg">Ultimo aggiornamento: {aggiornamento}.</p>
  </article>
</Base>
<style>
  .bozza { display: inline-block; background: var(--formaggio); color: var(--nero); padding: 10px 14px; border-radius: 10px; }
  .legale { max-width: 820px; padding-bottom: clamp(70px, 9vw, 120px); }
  .legale :global(h2) { font-family: var(--f-display); font-size: clamp(1.5rem, 1.2rem + 1vw, 2.1rem); margin: 36px 0 12px; line-height: 1; }
  .legale :global(h3) { font-weight: 800; font-size: var(--fs-l); margin: 22px 0 8px; }
  .legale :global(ul) { padding-left: 1.2em; }
  .legale :global(li) { margin-bottom: 6px; }
  .legale :global(table) { width: 100%; border-collapse: collapse; margin: 12px 0 20px; font-size: var(--fs-s); }
  .legale :global(th), .legale :global(td) { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--carta-2); vertical-align: top; }
  .legale :global(thead th) { background: var(--nero); color: var(--carta); }
  .legale :global(a) { text-decoration-color: var(--rosso); text-decoration-thickness: 2px; }
  .legale__agg { margin-top: 40px; color: var(--cenere); font-size: var(--fs-s); }
</style>
